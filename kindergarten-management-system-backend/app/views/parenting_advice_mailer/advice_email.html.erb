<% if @content_items.present? %>
  <div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; color: #1f2933; line-height: 1.7;">
    <h1 style="font-size: 22px; margin: 0 0 18px;">本期育儿精选</h1>

    <% @content_items.each do |item| %>
      <section style="border: 1px solid #d9e2ec; border-radius: 8px; padding: 16px; margin: 0 0 16px;">
        <% if item[:thumbnail].present? %>
          <img src="<%= item[:thumbnail] %>" alt="" style="max-width: 100%; border-radius: 6px; margin-bottom: 12px;">
        <% end %>
        <h2 style="font-size: 18px; margin: 0 0 8px;">
          <%= item[:title] %>
        </h2>
        <p style="font-size: 13px; color: #52606d; margin: 0 0 10px;">
          来源：<%= item[:source] %> |
          日期：<%= item[:date] %> |
          主题：<%= item[:topic] %> |
          适龄段：<%= item[:age_group] %>
        </p>
        <p style="margin: 0 0 12px;">
          <strong>AI 摘要：</strong><%= item[:summary] %>
        </p>
        <p style="margin: 0;">
          <a href="<%= item[:url] %>" style="color: #0967d2;">查看原文/视频链接</a>
        </p>
      </section>
    <% end %>

    <section style="border-left: 4px solid #2f855a; padding-left: 14px; margin-top: 18px;">
      <h2 style="font-size: 17px; margin: 0 0 8px;">AI 综合分析</h2>
      <p style="margin: 0;"><%= @ai_analysis %></p>
    </section>

    <p style="font-size: 12px; color: #697386; margin-top: 18px;">
      提示：本邮件仅用于家庭育儿信息参考，不替代专业医疗诊断或治疗建议。
    </p>
  </div>
<% else %>
  <%= simple_format(@body) %>
<% end %>
