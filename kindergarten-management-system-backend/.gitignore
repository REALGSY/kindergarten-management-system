# Rails/runtime artifacts
/log/*
!/log/.keep
/tmp/*
!/tmp/.keep
!/tmp/pids/
!/tmp/pids/.keep
/tmp/pids/*.pid
!/tmp/storage/
!/tmp/storage/.keep
/tmp/storage/**

# Local databases
/db/*.sqlite3
/db/*.sqlite3-*

# Local bundle/cache
/vendor/bundle
/.bundle

# Secrets and local environment
/config/master.key
.env
.env.*

# OS/editor noise
.DS_Store
Thumbs.db
